generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId         String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  college        String?
  department     String?
  bio            String?
  profilePicture String?
  createdAt      DateTime @default(now())
  accountStatus  String   @default("ACTIVE")
}
